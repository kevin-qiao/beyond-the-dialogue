        <mxCell id="act2" value="Attention Is All You Need (re-read)    [running]  step: Wiki: write — writing pages&#10;deposited: reading-notes.md · analysis-summary.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#243352;strokeColor=#5B8DEF;fontColor=#E8E9EC;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
