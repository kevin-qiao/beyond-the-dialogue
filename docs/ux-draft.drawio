          <mxGeometry x="240" y="440" width="320" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="cfgBox" value="Provider [openai ▾]   Model [gpt-4o ▾]   API key [••••••••]&#10;         [ Test connection ]   ·   wiki dir: ~/Documents/WorkBoard-Wiki" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2B2E35;strokeColor=#3A3D46;fontColor=#E8E9EC;fontSize=11;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="240" y="466" width="780" height="64" as="geometry"/>
