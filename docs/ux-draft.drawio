        <mxCell id="ttl" value="Welcome to Work Board" style="text;html=1;align=center;fontColor=#E8E9EC;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="80" width="900" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="A to-do board where an AI agent reads papers with you and files them into your personal wiki." style="text;html=1;align=center;fontColor=#9AA0AB;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="118" width="900" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="1   Paste a paper link&#10;      arXiv / DOI / any publisher URL — the app creates the task&#10;      and the agent starts reading it right away." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23252B;strokeColor=#3A3D46;fontColor=#E8E9EC;fontSize=11;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="240" y="180" width="780" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="2   Read with the agent's help&#10;      TLDR, contributions, reading suggestions — take notes in&#10;      markdown right next to the analysis." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23252B;strokeColor=#3A3D46;fontColor=#E8E9EC;fontSize=11;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="240" y="262" width="780" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="3   Finish → it files itself into your wiki&#10;      notes + summary land in your wiki (Obsidian-ready), index and&#10;      log updated, nothing to configure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23252B;strokeColor=#3A3D46;fontColor=#E8E9EC;fontSize=11;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="240" y="344" width="780" height="66" as="geometry"/>
        </mxCell>
