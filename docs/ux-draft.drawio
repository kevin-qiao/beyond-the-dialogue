          <mxGeometry x="60" y="640" width="340" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="princ" value="The agent is a silent co-worker: it works in the background, its presence is a thin status line + a rich Activity log. The user never watches the agent work — they check what it produced. v1 ships the same surface (status + activity), the only difference in v2 is that jobs start automatically." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F5F0;strokeColor=#B9B4A8;fontColor=#3A3630;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="670" width="700" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="g5" value="What v1 must do (concrete)" style="text;html=1;align=left;fontColor=#8A8F99;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="240" width="280" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="v1" value="· live job list in Activity (already have the ledger — add step + queued state)&#10;· ingest events stream into Activity while running (not only after)&#10;· toast for ingest: [View] jumps to Activity&#10;· sidebar status line shows current step / queued count&#10;· failed jobs show retry-with-backoff info, not just 'failed'&#10;· job events already flow via ev:job-progress / ev:ingest-updated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#243352;strokeColor=#5B8DEF;fontColor=#E8E9EC;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="780" y="270" width="420" height="160" as="geometry"/>
        </mxCell>
