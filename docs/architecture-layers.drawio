    <mxCell id="b1" value="Desktop hosts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1060" height="120" as="geometry"/></mxCell>
    <mxCell id="h_board" value="&lt;b&gt;Board UI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;tasks · Lists · alarms · state views&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="240" height="60" as="geometry"/></mxCell>
